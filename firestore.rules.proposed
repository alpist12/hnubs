rules_version = '2';

/* 좁힌 규칙 (아직 배포하지 않음).
 *
 * 지금 배포된 규칙(firestore.rules)은 2027-12-31 까지 인증 없이 읽기·쓰기를 모두 허용한다.
 * 그래서 주소만 알면 누구나 부원 일정을 읽고 고칠 수 있고,
 * 화면의 관리자 비밀번호 잠금도 Firestore 를 직접 건드리면 그냥 넘어간다.
 *
 * 이 파일을 배포하려면 먼저 두 가지가 되어 있어야 한다. 순서를 지키지 않으면 앱이 멈춘다.
 *
 *   1) Firebase 콘솔 → Authentication → Sign-in method → 익명(Anonymous) 사용 설정
 *      app.js 가 이미 익명 로그인을 시도한다. 꺼져 있으면 조용히 실패하고 넘어간다.
 *
 *   2) Netlify 환경변수 FIREBASE_SERVICE_ACCOUNT 에 서비스 계정 JSON
 *      api/ 함수들이 지금은 공개 웹 API 키로 쓴다. 아래에서 점검·AI분석작업 경로를
 *      클라이언트에게 막기 때문에, 서버는 서비스 계정으로 써야 한다.
 *
 * 둘 다 끝난 뒤:  firebase deploy --only firestore:rules
 * 그리고 이 파일 내용을 firestore.rules 로 옮겨 '배포된 것'과 일치시킨다.
 */

service cloud.firestore {
  match /databases/{database}/documents {

    // 방송국 운영 데이터. 로그인한 사람만.
    // 익명 로그인이라 '아무나 막는' 수준은 아니지만, 주소만 아는 사람은 막힌다.
    match /members/{memberId} {
      allow read, write: if request.auth != null;
      match /{sub=**} {
        allow read, write: if request.auth != null;
      }
    }
    match /shoots/{shootId}   { allow read, write: if request.auth != null; }
    match /projects/{id}      { allow read, write: if request.auth != null; }
    match /notices/{id}       { allow read, write: if request.auth != null; }

    // 점검 상태와 AI 분석 작업은 서버만 건드린다.
    // 클라이언트가 직접 쓰면 관리자 비밀번호가 의미를 잃는다.
    // 서비스 계정은 규칙을 거치지 않으므로 api/ 함수는 그대로 동작한다.
    match /scheduler/{doc=**} {
      allow read, write: if false;
    }

    // 나머지는 기본 거부.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
